<Window x:Class="PowerQuality.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Quality Monitoring Console" Height="720" Width="1180" MinHeight="600" MinWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Industrial Power Quality Monitoring" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Live device state, measurements, and alerts" Foreground="Gray" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="API:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="http://localhost:8080" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="16,0,0,0" Padding="16,6" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Devices" Margin="0,0,8,8">
                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="140" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAtUtc}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Live Measurement" Margin="8,0,0,8">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Voltage"/><TextBlock Grid.Column="1" Text="{Binding LiveState.Voltage, StringFormat={}{0:F1} V}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Current"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LiveState.Current, StringFormat={}{0:F2} A}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Text="Frequency"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LiveState.Frequency, StringFormat={}{0:F2} Hz}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Text="Power Factor"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LiveState.PowerFactor, StringFormat={}{0:F2}}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Text="Active Power"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LiveState.ActivePower, StringFormat={}{0:F2} kW}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="5" Text="Timestamp"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LiveState.TimestampUtc}" FontWeight="SemiBold"/>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Active / Recent Alerts" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding CreatedAtUtc}" Width="170" />
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="180" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
